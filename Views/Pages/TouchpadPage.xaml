<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinPlus.Views.Pages.TouchpadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="720">
            <TextBlock x:Name="Title" Text="Touchpad" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="PtpBar" IsOpen="True" IsClosable="False" Severity="Informational" />
            <TextBlock x:Name="Desc" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Text="" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenSettingsButton" Content="Open settings" Click="OpenOsSettings_Click" />
            </StackPanel>
            <CheckBox x:Name="RemapEnabled" Content="Enable mapping" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MeasureButton" Content="Measure" Click="Measure_Click" />
                <TextBlock x:Name="MeasureResult" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="" />
            </StackPanel>
            <TextBlock x:Name="Subtitle" Text="Mapping" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="GestureList" Spacing="8" />
            <Button x:Name="SaveButton" Content="Save" Click="Save_Click" />
            <TextBlock x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
