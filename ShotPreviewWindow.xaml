<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinPlus.ShotPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="win-plus"
    mc:Ignorable="d">

    <Grid RowSpacing="6" Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image x:Name="Preview" Stretch="Uniform" CanDrag="True" DragStarting="Preview_DragStarting" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="Countdown" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <Button x:Name="OpenButton" Content="Open" Click="Open_Click" />
            <Button x:Name="FolderButton" Content="Folder" Click="Folder_Click" />
            <Button x:Name="CloseButton" Content="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
