<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinPlus.RegionSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Overlay" Background="#99000000">
        <TextBlock x:Name="Hint" Text="Drag to select" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        <Canvas x:Name="SelCanvas">
            <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="2" Fill="#40FFFFFF" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
